{
  "name": "taskflow",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run test && npm run allure:generate && npm run allure:open",
    "dev": "concurrently \"npm run dev --workspace=apps/api\" \"npm run dev --workspace=apps/web\"",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:unit": "npm run test:unit --workspace=apps/api",
    "test:integration": "npm run test:integration --workspace=apps/api",
    "test:bdd": "cd taskflow-bdd && npm test",
    "test:bdd-only": "cd taskflow-bdd && npm test -- --tags @only",
    "test:e2e": "npx playwright test",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:bdd && npm run test:e2e",
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "test:mobile": "cd mobile && npx wdio run wdio.conf.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cucumber/cucumber": "^10.8.0",
    "@eslint/js": "^10.0.1",
    "@pact-foundation/pact": "^16.4.0",
    "@playwright/test": "^1.44.0",
    "@types/node": "^25.7.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@wdio/globals": "^9.27.1",
    "@wdio/types": "^9.27.1",
    "allure-commandline": "^2.42.0",
    "allure-js-commons": "^2.15.1",
    "allure-vitest": "^2.15.1",
    "concurrently": "^8.2.2",
    "dotenv": "^16.0.0",
    "globals": "^17.4.0",
    "prettier": "^3.9.3",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "dotenv-cli": "^11.0.0"
  }
}
